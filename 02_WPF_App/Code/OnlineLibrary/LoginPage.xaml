<Page x:Class="OnlineLibrary.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Авторизация">

    <Grid Background="{StaticResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Центральный контейнер -->
        <StackPanel Grid.Row="0" 
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Center"
                    Width="400">

            <!-- Заголовок -->
            <TextBlock Text="Добро пожаловать" 
                       Style="{StaticResource TitleTextBlock}"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="Войдите в свой аккаунт" 
                       Style="{StaticResource SubtitleTextBlock}"
                       HorizontalAlignment="Center"/>

            <!-- Поле логина -->
            <TextBlock Text="Логин" 
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,0,0,5"/>
            <TextBox x:Name="LoginTextBox" 
                     Style="{StaticResource InputTextBox}"/>

            <!-- Поле пароля -->
            <TextBlock Text="Пароль" 
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,0,0,5"/>
            <PasswordBox x:Name="PasswordBox" 
                         Style="{StaticResource InputPasswordBox}"/>

            <!-- Кнопка входа -->
            <Button x:Name="LoginButton" 
                    Content="Войти" 
                    Style="{StaticResource AccentButton}"
                    Click="LoginButton_Click"/>

            <!-- Ссылка на регистрацию -->
            <TextBlock HorizontalAlignment="Center" 
                       Margin="0,20,0,0">
                <Run Text="Нет аккаунта? " Foreground="{StaticResource TextSecondaryBrush}"/>
                <Hyperlink x:Name="RegisterLink" 
                           Foreground="{StaticResource AccentBrush}"
                           Click="RegisterLink_Click">
                    Зарегистрироваться
                </Hyperlink>
            </TextBlock>
        </StackPanel>

        <!-- Сообщение об ошибке -->
        <TextBlock x:Name="ErrorTextBlock" 
                   Grid.Row="1"
                   Text="" 
                   Foreground="Red" 
                   HorizontalAlignment="Center" 
                   Margin="0,0,0,20"
                   Visibility="Collapsed"/>
    </Grid>
</Page>