<Page x:Class="OnlineLibrary.BookListsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Списки книг">

    <Grid Background="{StaticResource WindowBackgroundBrush}" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" 
                   Text="Мои списки книг" 
                   Style="{StaticResource TitleTextBlock}"
                   Margin="0,0,0,20"/>

        <!-- Переключатель списков -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,20">
            <Button x:Name="BtnDropped" Content="Заброшено" 
                    Style="{StaticResource AccentButton}" Width="150" Margin="0,0,10,0"
                    Click="ListTab_Click" Tag="Заброшено"/>
            <Button x:Name="BtnPlans" Content="В планах" 
                    Style="{StaticResource AccentButton}" Width="150" Margin="0,0,10,0"
                    Click="ListTab_Click" Tag="В планах"/>
            <Button x:Name="BtnReading" Content="Читаю" 
                    Style="{StaticResource AccentButton}" Width="150" Margin="0,0,10,0"
                    Click="ListTab_Click" Tag="Читаю"/>
            <Button x:Name="BtnRead" Content="Прочитано" 
                    Style="{StaticResource AccentButton}" Width="150" Margin="0,0,10,0"
                    Click="ListTab_Click" Tag="Прочитано"/>
        </StackPanel>

        <!-- Панель управления (поиск, сортировка, фильтрация) -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,20">
            <!-- Поиск по названию -->
            <TextBox x:Name="SearchTitleTextBox" 
                     Style="{StaticResource InputTextBoxWithPlaceholder}"
                     Width="250"
                     Margin="0,0,10,0"
                     Tag="Поиск по названию..."
                     ToolTip="Введите название книги"/>
            <TextBlock Text="🔍" VerticalAlignment="Center" Margin="0,0,20,0" FontSize="16"/>

            <!-- Поиск по автору -->
            <TextBox x:Name="SearchAuthorTextBox" 
                     Style="{StaticResource InputTextBoxWithPlaceholder}"
                     Width="250"
                     Margin="0,0,10,0"
                     Tag="Поиск по автору..."
                     ToolTip="Введите имя автора"/>
            <TextBlock Text="✍️" VerticalAlignment="Center" Margin="0,0,20,0" FontSize="16"/>

            <!-- Сортировка -->
            <Grid Width="200" Margin="0,0,10,0">
                <ComboBox x:Name="SortComboBox" 
                          Style="{StaticResource DarkComboBox}"
                          ItemContainerStyle="{StaticResource DarkComboBoxItem}"
                          SelectionChanged="SortComboBox_SelectionChanged">
                    <ComboBoxItem Content="Сортировка: по названию" Tag="Title"/>
                    <ComboBoxItem Content="Сортировка: по оценке" Tag="Rating"/>
                </ComboBox>
                <TextBlock x:Name="SortPlaceholder" 
                           Text="Выберите сортировку..."
                           Foreground="#808080"
                           FontSize="14"
                           Margin="12,0,0,0"
                           IsHitTestVisible="False"
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- Фильтр по жанрам -->
            <Grid Width="200">
                <ComboBox x:Name="GenreFilterComboBox" 
                          Style="{StaticResource DarkComboBox}"
                          ItemContainerStyle="{StaticResource DarkComboBoxItem}"
                          SelectionChanged="GenreFilterComboBox_SelectionChanged">
                    <ComboBoxItem Content="Все жанры" Tag="All"/>
                </ComboBox>
                <TextBlock x:Name="GenrePlaceholder" 
                           Text="Все жанры"
                           Foreground="#808080"
                           FontSize="14"
                           Margin="12,0,0,0"
                           IsHitTestVisible="False"
                           VerticalAlignment="Center"/>
            </Grid>
        </StackPanel>

        <!-- Сетка книг -->
        <ScrollViewer Grid.Row="3" 
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="BooksItemsControl">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource SurfaceBrush}"
                                CornerRadius="10" Margin="10"
                                Width="250" Height="380">
                            <Grid Margin="15">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="150"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Обложка -->
                                <Border Grid.Row="0" Background="{StaticResource AccentBrush}"
                                        CornerRadius="5" Margin="0,0,0,10">
                                    <TextBlock Text="📚" FontSize="60" 
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center"/>
                                </Border>

                                <!-- Название -->
                                <TextBlock Grid.Row="1" Text="{Binding Title}" 
                                           FontWeight="Bold" FontSize="16"
                                           TextWrapping="Wrap" Margin="0,0,0,5"/>

                                <!-- Автор -->
                                <TextBlock Grid.Row="2" Text="{Binding AuthorName}" 
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12" Margin="0,0,0,5"/>

                                <!-- Жанр -->
                                <TextBlock Grid.Row="3" Text="{Binding Genres}" 
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="11" Margin="0,0,0,10"/>

                                <!-- Кнопка перемещения -->
                                <ComboBox Grid.Row="4" x:Name="MoveComboBox"
                                          Tag="{Binding Id}"
                                          Style="{StaticResource DarkComboBox}"
                                          ItemContainerStyle="{StaticResource DarkComboBoxItem}"
                                          Padding="5,3" Margin="0,0,0,5"
                                          SelectionChanged="MoveComboBox_SelectionChanged">
                                    <ComboBoxItem Content="Переместить в..." IsSelected="True"/>
                                    <ComboBoxItem Content="Заброшено" Tag="Заброшено"/>
                                    <ComboBoxItem Content="В планах" Tag="В планах"/>
                                    <ComboBoxItem Content="Читаю" Tag="Читаю"/>
                                    <ComboBoxItem Content="Прочитано" Tag="Прочитано"/>
                                </ComboBox>

                                <!-- Кнопка удаления -->
                                <Button Grid.Row="5" Content="Удалить из списка"
                                        Tag="{Binding Id}"
                                        Style="{StaticResource AccentButton}"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Bottom"
                                        Click="RemoveBook_Click"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>