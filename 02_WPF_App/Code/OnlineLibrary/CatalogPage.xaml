<Page x:Class="OnlineLibrary.CatalogPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Каталог книг">

    <Grid Background="{StaticResource WindowBackgroundBrush}" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" 
                   Text="Каталог книг" 
                   Style="{StaticResource TitleTextBlock}"
                   Margin="0,0,0,20"/>

        <!-- Панель управления (поиск, сортировка, фильтрация) -->
        <StackPanel Grid.Row="1" 
                    Orientation="Horizontal" 
                    Margin="0,0,0,20">

            <!-- Поиск по названию -->
            <TextBox x:Name="SearchTitleTextBox" 
                     Style="{StaticResource InputTextBoxWithPlaceholder}"
                     Width="200"
                     Margin="0,0,5,0"
                     Tag="Поиск по названию..."
                     ToolTip="Введите название книги"
                     KeyDown="SearchTextBox_KeyDown"/>

            <!-- Поиск по автору -->
            <TextBox x:Name="SearchAuthorTextBox" 
                     Style="{StaticResource InputTextBoxWithPlaceholder}"
                     Width="200"
                     Margin="0,0,5,0"
                     Tag="Поиск по автору..."
                     ToolTip="Введите имя автора"
                     KeyDown="SearchTextBox_KeyDown"/>

            <!-- Кнопка Найти -->
            <Button Content="🔍 Найти"
                    Style="{StaticResource AccentButton}"
                    Width="100" Height="40"
                    Margin="0,0,10,0"
                    Padding="5,5"
                    FontSize="13"
                    Click="SearchButton_Click"/>

            <!-- Сортировка -->
            <Grid Width="180" Margin="0,0,10,0">
                <ComboBox x:Name="SortComboBox" 
                          Style="{StaticResource DarkComboBox}"
                          ItemContainerStyle="{StaticResource DarkComboBoxItem}"
                          SelectionChanged="SortComboBox_SelectionChanged">
                    <ComboBoxItem Content="По названию" Tag="Title"/>
                    <ComboBoxItem Content="По оценке" Tag="Rating"/>
                </ComboBox>
                <TextBlock x:Name="SortPlaceholder" 
                           Text="Сортировка..."
                           Foreground="#808080"
                           FontSize="14"
                           Margin="12,0,0,0"
                           IsHitTestVisible="False"
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- Фильтр по жанрам -->
            <Grid Width="180">
                <ComboBox x:Name="GenreFilterComboBox" 
                          Style="{StaticResource DarkComboBox}"
                          ItemContainerStyle="{StaticResource DarkComboBoxItem}"
                          SelectionChanged="GenreFilterComboBox_SelectionChanged">
                    <ComboBoxItem Content="Все жанры" Tag="All"/>
                </ComboBox>
                <TextBlock x:Name="GenrePlaceholder" 
                           Text="Все жанры"
                           Foreground="#808080"
                           FontSize="14"
                           Margin="12,0,0,0"
                           IsHitTestVisible="False"
                           VerticalAlignment="Center"/>
            </Grid>
        </StackPanel>

        <!-- Сетка книг -->
        <ScrollViewer Grid.Row="2" 
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="BooksItemsControl">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource SurfaceBrush}"
                                CornerRadius="10"
                                Margin="10"
                                Width="250"
                                Height="420"
                                Cursor="Hand">
                            <Grid Margin="15">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="160"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Обложка (заглушка) -->
                                <Border Grid.Row="0" 
                                        Background="{StaticResource AccentBrush}"
                                        CornerRadius="5"
                                        Margin="0,0,0,10">
                                    <TextBlock Text="📚" 
                                               FontSize="70" 
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center"/>
                                </Border>

                                <!-- Название -->
                                <TextBlock Grid.Row="1" 
                                           Text="{Binding Title}" 
                                           FontWeight="Bold"
                                           FontSize="15"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,5"/>

                                <!-- Автор -->
                                <TextBlock Grid.Row="2" 
                                           Text="{Binding AuthorName}" 
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12"
                                           Margin="0,0,0,5"/>

                                <!-- Жанр -->
                                <TextBlock Grid.Row="3" 
                                           Text="{Binding Genres}" 
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="11"
                                           Margin="0,0,0,5"/>

                                <!-- Рейтинг -->
                                <TextBlock Grid.Row="4" 
                                           Text="{Binding RatingText}" 
                                           Foreground="{StaticResource AccentBrush}"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Margin="0,0,0,5"/>

                                <!-- Кнопка "Добавить в список" -->
                                <ComboBox Grid.Row="5" 
                                          Tag="{Binding Id}"
                                          Style="{StaticResource DarkComboBox}"
                                          ItemContainerStyle="{StaticResource DarkComboBoxItem}"
                                          Padding="5,3" 
                                          Margin="0,0,0,5"
                                          VerticalAlignment="Top"
                                          SelectionChanged="AddToListComboBox_SelectionChanged">
                                    <ComboBoxItem Content="➕ В список..." IsSelected="True"/>
                                    <ComboBoxItem Content="Читаю" Tag="Читаю"/>
                                    <ComboBoxItem Content="В планах" Tag="В планах"/>
                                    <ComboBoxItem Content="Прочитано" Tag="Прочитано"/>
                                    <ComboBoxItem Content="Заброшено" Tag="Заброшено"/>
                                </ComboBox>

                                <!-- Кнопка "Подробнее" -->
                                <Button Grid.Row="5" 
                                        Content="Подробнее"
                                        Style="{StaticResource AccentButton}"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Bottom"
                                        Margin="0,30,0,0"
                                        Click="BookCard_Click"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>