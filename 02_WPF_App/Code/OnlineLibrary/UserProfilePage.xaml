<Page x:Class="OnlineLibrary.UserProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Профиль пользователя">

    <Grid Background="{StaticResource WindowBackgroundBrush}" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" 
                   Text="Профиль пользователя" 
                   Style="{StaticResource TitleTextBlock}"
                   Margin="0,0,0,20"/>

        <!-- Предупреждение о заморозке -->
        <Border x:Name="FreezeWarningBorder" 
                Grid.Row="1"
                Background="#FFFF4444"
                CornerRadius="5"
                Padding="15"
                Margin="0,0,0,20"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="️ Ваш аккаунт заморожен!" 
                           FontWeight="Bold"
                           FontSize="16"
                           Foreground="White"
                           Margin="0,0,0,5"/>
                <TextBlock x:Name="FreezeReasonText" 
                           Text="Причина: " 
                           Foreground="White"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10"/>
                <Button Content="Оспорить заморозку"
                        Style="{StaticResource AccentButton}"
                        HorizontalAlignment="Left"
                        Click="DisputeFreeze_Click"/>
            </StackPanel>
        </Border>

        <!-- Основная информация -->
        <Border Grid.Row="2" 
                Background="{StaticResource SurfaceBrush}"
                CornerRadius="10"
                Padding="20"
                VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Информация о пользователе" 
                           Style="{StaticResource TitleTextBlock}"
                           FontSize="20"
                           Margin="0,0,0,20"/>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Имя:" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                    <TextBlock x:Name="NameText" Grid.Column="1" Text=""/>
                </Grid>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Логин:" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                    <TextBlock x:Name="LoginText" Grid.Column="1" Text=""/>
                </Grid>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Email:" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                    <TextBlock x:Name="EmailText" Grid.Column="1" Text=""/>
                </Grid>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Роль:" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                    <TextBlock x:Name="RoleText" Grid.Column="1" Text=""/>
                </Grid>

                <!-- Разделитель перед блоком отзывов -->
                <Separator x:Name="ReviewsSeparator" Margin="0,0,0,20"/>

                <!-- Заголовок блока отзывов -->
                <TextBlock x:Name="ReviewsHeaderText"
                           Text="Мои отзывы" 
                           Style="{StaticResource TitleTextBlock}"
                           FontSize="20"
                           Margin="0,0,0,20"/>

                <!-- Список отзывов пользователя -->
                <ItemsControl x:Name="ReviewsItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource WindowBackgroundBrush}"
                                    CornerRadius="5"
                                    Padding="15"
                                    Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="{Binding BookTitle}" 
                                               FontWeight="Bold"
                                               FontSize="16"
                                               Margin="0,0,0,5"/>
                                    <TextBlock Text="{Binding ReviewText}" 
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,5"/>
                                    <TextBlock Text="{Binding RatingText}" 
                                               Foreground="{StaticResource AccentBrush}"
                                               FontSize="12"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Grid>
</Page>