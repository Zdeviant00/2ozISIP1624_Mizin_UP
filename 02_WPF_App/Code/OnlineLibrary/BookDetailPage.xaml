<Page x:Class="OnlineLibrary.BookDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Подробности о книге">

    <Grid Background="{StaticResource WindowBackgroundBrush}" Margin="20">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Кнопка "Назад" -->
                <Button Content="← Назад к каталогу"
                        Style="{StaticResource AccentButton}"
                        HorizontalAlignment="Left"
                        Width="200" Height="40"
                        Margin="0,0,0,20"
                        Click="BackButton_Click"/>

                <!-- Основная информация о книге -->
                <Border Background="{StaticResource SurfaceBrush}"
                        CornerRadius="10"
                        Padding="20"
                        Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Обложка -->
                        <Border Grid.Column="0" 
                                Background="{StaticResource AccentBrush}"
                                CornerRadius="5"
                                Height="280"
                                Margin="0,0,20,0">
                            <TextBlock Text="📚" 
                                       FontSize="100" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"/>
                        </Border>

                        <!-- Информация -->
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="TitleText" 
                                       Style="{StaticResource TitleTextBlock}"
                                       FontSize="28"
                                       Margin="0,0,0,10"/>

                            <TextBlock Text="Автор:" 
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="14"
                                       Margin="0,0,0,5"/>
                            <TextBlock x:Name="AuthorText" 
                                       FontSize="16"
                                       Margin="0,0,0,15"/>

                            <TextBlock Text="Жанры:" 
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="14"
                                       Margin="0,0,0,5"/>
                            <TextBlock x:Name="GenresText" 
                                       FontSize="16"
                                       Margin="0,0,0,15"/>

                            <TextBlock Text="Рейтинг:" 
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="14"
                                       Margin="0,0,0,5"/>
                            <TextBlock x:Name="RatingText" 
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource AccentBrush}"
                                       Margin="0,0,0,15"/>

                            <!-- Кнопка "Добавить в список" -->
                            <ComboBox x:Name="AddToListComboBox"
                                      Style="{StaticResource DarkComboBox}"
                                      ItemContainerStyle="{StaticResource DarkComboBoxItem}"
                                      Width="250"
                                      HorizontalAlignment="Left"
                                      Margin="0,0,0,15"
                                      SelectionChanged="AddToListComboBox_SelectionChanged">
                                <ComboBoxItem Content="➕ Добавить в список..." IsSelected="True"/>
                                <ComboBoxItem Content="Читаю" Tag="Читаю"/>
                                <ComboBoxItem Content="В планах" Tag="В планах"/>
                                <ComboBoxItem Content="Прочитано" Tag="Прочитано"/>
                                <ComboBoxItem Content="Заброшено" Tag="Заброшено"/>
                            </ComboBox>

                            <!-- Кнопки действий с книгой -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <!-- Кнопка "Пожаловаться на книгу" -->
                                <Button x:Name="ComplainBookButton"
                                        Content="⚠ Пожаловаться на книгу"
                                        Style="{StaticResource AccentButton}"
                                        Width="220" Height="40"
                                        Padding="10,5"
                                        FontSize="13"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center"
                                        Click="ComplainBook_Click"/>

                                <!-- Кнопка "Заморозить/Разморозить книгу" (только для админа) -->
                                <Button x:Name="FreezeBookButton"
                                        Style="{StaticResource AccentButton}"
                                        Width="200" Height="40"
                                        Padding="10,5"
                                        FontSize="13"
                                        Margin="0,0,0,0"
                                        VerticalAlignment="Center"
                                        Visibility="Collapsed"
                                        Click="FreezeBook_Click"/>
                            </StackPanel>

                            <!-- Предупреждение о заморозке -->
                            <Border x:Name="FrozenWarning"
                                    Background="#33FF0000"
                                    CornerRadius="5"
                                    Padding="10"
                                    Visibility="Collapsed"
                                    Margin="0,10,0,0">
                                <TextBlock Text="⚠️ Эта книга заморожена и недоступна для чтения"
                                           Foreground="White"
                                           FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Описание -->
                <Border Background="{StaticResource SurfaceBrush}"
                        CornerRadius="10"
                        Padding="20"
                        Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Описание" 
                                   Style="{StaticResource TitleTextBlock}"
                                   FontSize="20"
                                   Margin="0,0,0,10"/>
                        <TextBlock x:Name="DescriptionText" 
                                   TextWrapping="Wrap"
                                   FontSize="14"
                                   LineHeight="22"/>
                    </StackPanel>
                </Border>

                <!-- Форма добавления отзыва -->
                <Border Background="{StaticResource SurfaceBrush}"
                        CornerRadius="10"
                        Padding="20"
                        Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Оставить отзыв" 
                                   Style="{StaticResource TitleTextBlock}"
                                   FontSize="20"
                                   Margin="0,0,0,10"/>

                        <!-- Рейтинг -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="Ваша оценка:" 
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>
                            <ComboBox x:Name="RatingComboBox"
                                      Style="{StaticResource DarkComboBox}"
                                      ItemContainerStyle="{StaticResource DarkComboBoxItem}"
                                      Width="100">
                                <ComboBoxItem Content="5 ⭐" Tag="5" IsSelected="True"/>
                                <ComboBoxItem Content="4 ⭐" Tag="4"/>
                                <ComboBoxItem Content="3 ⭐" Tag="3"/>
                                <ComboBoxItem Content="2 ⭐" Tag="2"/>
                                <ComboBoxItem Content="1 ⭐" Tag="1"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Текст отзыва -->
                        <TextBox x:Name="ReviewTextBox"
                                 Style="{StaticResource InputTextBoxWithPlaceholder}"
                                 Height="100"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 Tag="Напишите ваш отзыв..."
                                 Margin="0,0,0,10"/>

                        <Button Content="Опубликовать отзыв"
                                Style="{StaticResource AccentButton}"
                                HorizontalAlignment="Left"
                                Width="220" Height="40"
                                Padding="10,5"
                                FontSize="13"
                                Click="SubmitReview_Click"/>
                    </StackPanel>
                </Border>

                <!-- Список отзывов -->
                <Border Background="{StaticResource SurfaceBrush}"
                        CornerRadius="10"
                        Padding="20">
                    <StackPanel>
                        <TextBlock Text="Отзывы читателей" 
                                   Style="{StaticResource TitleTextBlock}"
                                   FontSize="20"
                                   Margin="0,0,0,15"/>

                        <ItemsControl x:Name="ReviewsItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource WindowBackgroundBrush}"
                                            CornerRadius="5"
                                            Padding="15"
                                            Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Заголовок отзыва -->
                                            <StackPanel Grid.Row="0" Orientation="Horizontal">
                                                <TextBlock Text="{Binding UserName}" 
                                                           FontWeight="Bold"
                                                           FontSize="14"
                                                           Margin="0,0,10,0"/>
                                                <TextBlock Text="{Binding RatingText}" 
                                                           Foreground="{StaticResource AccentBrush}"
                                                           FontWeight="Bold"
                                                           FontSize="14"/>
                                                <!-- Индикатор заморозки отзыва -->
                                                <TextBlock Text="❄️ Заморожен"
                                                           Foreground="#FFFF4444"
                                                           FontWeight="Bold"
                                                           FontSize="12"
                                                           Margin="10,0,0,0"
                                                           Visibility="{Binding FrozenIndicatorVisibility}"/>
                                            </StackPanel>

                                            <!-- Текст отзыва -->
                                            <TextBlock Grid.Row="1" 
                                                       Text="{Binding Text}" 
                                                       TextWrapping="Wrap"
                                                       Margin="0,10,0,10"
                                                       FontSize="14"/>

                                            <!-- Кнопки действий -->
                                            <Grid Grid.Row="2" Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="150"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Кнопка "Пожаловаться" (только для обычных пользователей на чужие отзывы) -->
                                                <Button Grid.Column="0"
                                                        Content="⚠ Пожаловаться"
                                                        Tag="{Binding Id}"
                                                        Style="{StaticResource AccentButton}"
                                                        Height="40"
                                                        Padding="5,3"
                                                        Margin="0,0,5,0"
                                                        FontSize="12"
                                                        HorizontalContentAlignment="Center"
                                                        VerticalContentAlignment="Center"
                                                        Visibility="{Binding ComplainButtonVisibility}"
                                                        Click="ComplainReview_Click"/>

                                                <!-- Кнопка "Редактировать" (только для автора отзыва) -->
                                                <Button Grid.Column="0"
                                                        Content="✏ Редактировать"
                                                        Tag="{Binding Id}"
                                                        Style="{StaticResource AccentButton}"
                                                        Height="40"
                                                        Padding="5,3"
                                                        Margin="0,0,5,0"
                                                        FontSize="12"
                                                        HorizontalContentAlignment="Center"
                                                        VerticalContentAlignment="Center"
                                                        Visibility="{Binding EditButtonVisibility}"
                                                        Click="EditReview_Click"/>

                                                <!-- Кнопка "Заморозить/Разморозить" (только для админа) -->
                                                <Button Grid.Column="0"
                                                        Content="{Binding FreezeButtonText}"
                                                        Tag="{Binding Id}"
                                                        Style="{StaticResource AccentButton}"
                                                        Height="40"
                                                        Padding="5,3"
                                                        Margin="0,0,5,0"
                                                        FontSize="12"
                                                        HorizontalContentAlignment="Center"
                                                        VerticalContentAlignment="Center"
                                                        Visibility="{Binding AdminFreezeButtonVisibility}"
                                                        Click="FreezeReview_Click"/>

                                                
                                                <!-- Кнопка "Удалить" (только для автора отзыва) -->
                                                <Button Grid.Column="1"
                                                        Content="🗑 Удалить"
                                                        Tag="{Binding Id}"
                                                        Style="{StaticResource AccentButton}"
                                                        Height="40"
                                                        Padding="5,3"
                                                        Margin="0,0,5,0"
                                                        FontSize="12"
                                                        HorizontalContentAlignment="Center"
                                                        VerticalContentAlignment="Center"
                                                        Visibility="{Binding DeleteButtonVisibility}"
                                                        Click="DeleteReview_Click"/>

                                                <!-- Колонка 3: Пустая (резерв) -->
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="NoReviewsText"
                                   Text="Пока нет отзывов. Будьте первым!"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontStyle="Italic"
                                   HorizontalAlignment="Center"
                                   Margin="0,20,0,0"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>